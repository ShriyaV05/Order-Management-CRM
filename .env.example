# Required. The app uses this ONE Turso database only (no local sqlite fallback).
TURSO_DATABASE_URL=https://popcone-db-shriyav05.aws-ap-south-1.turso.io
TURSO_AUTH_TOKEN=your_turso_auth_token_here

# --- Primary Backup Storage: Google Drive (Personal Free 15 GB Quota, Zero Cost) ---
# Obtain credentials by running: python scripts/setup_gdrive_auth.py
# Uses restricted scope: https://www.googleapis.com/auth/drive.file (only accesses its own files)
GDRIVE_CLIENT_ID=your_oauth_client_id.apps.googleusercontent.com
GDRIVE_CLIENT_SECRET=your_oauth_client_secret
GDRIVE_REFRESH_TOKEN=your_oauth_refresh_token
# Optional: specific folder ID in your Drive (defaults to creating 'POPCONE_BACKUPS')
GDRIVE_FOLDER_ID=

# --- Legacy Backup Storage: External S3-Compatible Object Storage (Optional Fallback) ---
# Used only if Google Drive credentials are not set.
BACKUP_S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
BACKUP_S3_BUCKET=popcone-crm-backups
BACKUP_S3_REGION=auto
BACKUP_S3_ACCESS_KEY_ID=your_s3_access_key_id
BACKUP_S3_SECRET_ACCESS_KEY=your_s3_secret_access_key

# --- Backup Encryption & HMAC Authenticity Keys ---
# 32-byte hexadecimal or base64 keys
BACKUP_ENCRYPTION_KEY=your_32_byte_aes_gcm_encryption_key_here
BACKUP_SIGNING_KEY=your_32_byte_hmac_sha256_signing_key_here
CURRENT_ENCRYPTION_KEY_ID=enc_v1
CURRENT_SIGNING_KEY_ID=sign_v1

# --- Vercel Cron Authentication & Long-Term Retention Policy ---
# Required for automated Vercel Cron backups (/api/cron/daily-backup).
# Set the same CRON_SECRET in Vercel Environment Variables.
CRON_SECRET=your_vercel_cron_secret_here
# Daily backup retention period in days (default: 90, minimum safety floor: 7)
BACKUP_DAILY_RETENTION_DAYS=90
# Backward-compatible alias for daily retention
BACKUP_RETENTION_DAYS=90
# Monthly recovery point retention in months (default: 12 months)
BACKUP_MONTHLY_RETENTION_MONTHS=12
# Minimum number of recent backups to always preserve regardless of age (default: 3, min: 1)
MIN_BACKUPS_RETAINED=3
