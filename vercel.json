{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "fastapi",
  "functions": {
    "server.py": {
      "maxDuration": 60,
      "includeFiles": "{static/**,logo.jpg,icon.png,auth.py,database.py,locations.py}"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/server.py"
    }
  ]
}
